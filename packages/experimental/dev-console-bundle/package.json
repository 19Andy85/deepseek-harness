{
  "name": "@deepseek-ai/dsh-experimental-dev-console-bundle",
  "description": "Experimental project console: workspace-level live session task overview with its browser page and the model-facing session_tasks tool",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/dev-console-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-api-session-tasks": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-dev-console": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-session-tasks": "workspace:*",
    "js-yaml": "^4.3.2"
  }
}
